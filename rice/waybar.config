[
  {
    "backlight": {
      "device": "amdgpu",
      "format": "{percent}% {icon}",
      "format-icons": [
        "󰃚 ",
        "󰃛 ",
        "󰃜 ",
        "󰃝 ",
        "󰃞 ",
        "󰃟 ",
        "󰃠 "
      ]
    },
    "battery": {
      "format": "{time} {capacity}% {icon}",
      "format-charging": "{time} {capacity}% {icon} 󱐋",
      "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "format-plugged": "{capacity}%  ",
      "states": {
        "critical": 15,
        "warning": 30
      }
    },
    "clock": {
      "actions": {
        "on-click-backward": "tz_down",
        "on-click-forward": "tz_up",
        "on-click-right": "mode",
        "on-scroll-down": "shift_down",
        "on-scroll-up": "shift_up"
      },
      "calendar": {
        "format": {
          "days": "<span color='#ecc6d9'><b>{}</b></span>",
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "weeks": "<span color='#99ffdd'><b>W{}</b></span>"
        },
        "mode": "year",
        "mode-mon-col": 3,
        "on-scroll": 1,
        "weeks-pos": "right"
      },
      "format": "{:%T}",
      "interval": 1,
      "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
      "format": "{usage}%  ",
      "tooltip": false
    },
    "custom/syncstat": {
      "exec": "/nix/store/sf204r2l6dh4y19cy3rn9sp0yzb0mchr-syncstat.py/bin/syncstat.py",
      "format": "󰓦  {text}",
      "hide-empty-text": true
    },
    "custom/weather": {
      "exec": "/nix/store/vixw0f7drvaxja1zvh42kyc749ky31xj-waybar-weather-0.3.0-unstable-2026-01-30/bin/waybar-weather -config /nix/store/v2aa66ph2wrz8hk4hvzxd3cjlkwp6q8q-waybar-weather.yaml",
      "format": "{} ",
      "hide-empty-text": true,
      "restart-interval": 60,
      "return-type": "json"
    },
    "disk": {
      "format": "{percentage_used}% 󰋊 ",
      "path": "/full"
    },
    "hyprland/workspaces": {
      "all-outputs": false,
      "format": "{icon}",
      "format-icons": {
        "1": "",
        "10": "",
        "2": "",
        "3": "",
        "4": "",
        "5": "4",
        "6": "5",
        "7": "6",
        "8": "7",
        "9": "8"
      },
      "sort-by-number": true
    },
    "idle_inhibitor": {
      "format": "{icon} ",
      "format-icons": {
        "activated": "󰈈",
        "deactivated": "󰈉"
      }
    },
    "ipc": true,
    "layer": "top",
    "memory": {
      "format": "{}%  "
    },
    "modules-center": [
      "hyprland/window"
    ],
    "modules-left": [
      "hyprland/workspaces",
      "custom/syncstat"
    ],
    "modules-right": [
      "custom/weather",
      "mpd",
      "pulseaudio",
      "network",
      "cpu",
      "memory",
      "disk",
      "temperature",
      "backlight",
      "battery",
      "clock",
      "idle_inhibitor",
      "tray"
    ],
    "mpd": {
      "consume-icons": {
        "on": " "
      },
      "format": "{stateIcon}{consumeIcon}{randomIcon}{repeatIcon}{singleIcon} {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩  ",
      "format-disconnected": "Disconnected 󰀦 ",
      "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon} Stopped 󰝛 ",
      "interval": 2,
      "random-icons": {
        "on": "  "
      },
      "repeat-icons": {
        "on": "󰑖 "
      },
      "single-icons": {
        "on": "󰑘 "
      },
      "state-icons": {
        "paused": " ",
        "playing": " "
      },
      "tooltip-format": "MPD (connected)",
      "tooltip-format-disconnected": "MPD (disconnected)",
      "unknown-tag": ""
    },
    "network": {
      "family": "ipv4",
      "format-disconnected": "Disconnected 󰀦 ",
      "format-ethernet": "{ipaddr}/{cidr} 󰈀 ",
      "format-linked": "{ifname} (No IP) 󰀦 ",
      "format-wifi": "{essid} ({signalStrength}%)  ",
      "tooltip-format": "{ifname} via {gwaddr} 󰈀 "
    },
    "position": "top",
    "pulseaudio": {
      "format": "{volume}% {icon} {format_source}",
      "format-bluetooth": "{volume}% {icon} {format_source}",
      "format-bluetooth-muted": " {icon} {format_source}",
      "format-icons": {
        "default": [
          " ",
          " ",
          "󰕾 ",
          " "
        ],
        "headphone": " "
      },
      "format-muted": "  {format_source}",
      "format-source": "{volume}% ",
      "format-source-muted": " "
    },
    "spacing": 2,
    "temperature": {
      "critical-threshold": 70,
      "format": "{temperatureC}°C {icon}",
      "format-critical": "{temperatureC}°C {icon}",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "hwmon-path": "/dev/cpu_temp"
    },
    "tray": {
      "spacing": 10
    }
  }
]
